# ==============================
# База данных
# ==============================
POSTGRES_PASSWORD=your_strong_password_here
DATABASE_URL=postgresql+asyncpg://postgres:your_strong_password_here@localhost:5432/ecohaul
DATABASE_URL_SYNC=postgresql://postgres:your_strong_password_here@localhost:5432/ecohaul

# ==============================
# Redis
# ==============================
REDIS_URL=redis://localhost:6379/0

# ==============================
# Безопасность
# ==============================
# Генерировать: openssl rand -hex 32
SECRET_KEY=your_secret_key_here
DEBUG=False

# ==============================
# Telegram Bot
# ==============================
# Получить у @BotFather
BOT_TOKEN=your_bot_token_here
WEBAPP_URL=https://your-domain.com

# ==============================
# Платёжный провайдер
# ==============================
PAYMENT_PROVIDER=yookassa
YOOKASSA_SHOP_ID=your_shop_id
YOOKASSA_SECRET_KEY=your_secret_key
YOOKASSA_RETURN_URL=https://your-domain.com/payment/success

# ==============================
# SMTP (для email уведомлений)
# ==============================
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your-email@gmail.com
SMTP_PASSWORD=your_app_password
SMTP_FROM_EMAIL=noreply@ecohaul.by
SMTP_USE_TLS=True

# ==============================
# CORS (домены через запятую)
# ==============================
ALLOWED_ORIGINS=["https://your-domain.com"]
